# Frontend endpoint. Leave as-is when the app and Cloudflare Pages Function use the same domain.
VITE_DRAWING_SAMPLE_UPLOAD_URL=/api/drawing-samples

# Optional Vosk Browser model overrides for Voice Defender.
VITE_VOSK_MODEL_ZH_URL=https://ccoreilly.github.io/vosk-browser/models/vosk-model-small-cn-0.3.tar.gz
VITE_VOSK_MODEL_EN_URL=https://ccoreilly.github.io/vosk-browser/models/vosk-model-small-en-us-0.15.tar.gz
VITE_VOSK_MODEL_TIMEOUT_MS=90000
VITE_VOSK_MODEL_RETRY_MS=10000
VITE_VOSK_MODEL_MIN_BYTES=1048576

# Server-side only. Set this in Cloudflare Pages environment variables or .dev.vars.
DISCORD_DRAWING_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Optional, comma-separated. Use this only if the frontend is hosted on another origin.
DRAWING_UPLOAD_ALLOWED_ORIGINS=https://example.github.io
